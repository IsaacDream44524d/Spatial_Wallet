<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="520.0" prefWidth="674.0" spacing="0" style="-fx-background-color: white;-fx-border-color: #e5e7eb;-fx-border-width: 1;              -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 24, 0, 0, 8);" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="hashwallet.must.hash_wallet.Controller">

    <!-- ==================== TOP SECTION ==================== -->
    <VBox spacing="22.0">
        <padding>
            <Insets bottom="10" left="24" right="24" top="22" />
        </padding>

        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="14">
            <ImageView fitHeight="48" fitWidth="48" preserveRatio="true">
                <image>
                    <Image url="@../../../images/money.png" />
                </image>
            </ImageView>

            <VBox spacing="2" HBox.hgrow="ALWAYS">
                <Label style="-fx-text-fill: #111827; -fx-font-weight: bold; -fx-font-size: 18px;" text="Spatial Wallet" />
                <Label style="-fx-text-fill: #6b7280; -fx-font-size: 13px;" text="Overview of all wallets" />
            </VBox>

            <Button onAction="#landingPage" style="-fx-background-color: #f3f4f6;                            -fx-text-fill: #374151;                            -fx-font-size: 13px;                            -fx-font-weight: bold;                            -fx-background-radius: 8;                            -fx-padding: 8 16 8 16;                            -fx-cursor: hand;" text="Back" />
        </HBox>

        <!-- Total Balance Card -->
        <VBox spacing="8" style="-fx-background-color: #1e293b;                      -fx-background-radius: 14;                      -fx-padding: 28 24 28 24;">

            <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 13.5px;" text="Total Balance" />

            <HBox alignment="BASELINE_LEFT" spacing="6">
                <Label fx:id="currencyLabel" style="-fx-text-fill: #e2e8f0;                               -fx-font-size: 20px;                               -fx-font-weight: bold;" text="MWK" />

                <Label fx:id="totalBalanceLabel" style="-fx-text-fill: white;                               -fx-font-size: 36px;                               -fx-font-weight: bold;" text="0.00" />
            </HBox>
        </VBox>
    </VBox>

    <!-- Spacer -->
    <Region VBox.vgrow="ALWAYS" />

    <!-- ==================== BOTTOM IMAGE ==================== -->
    <ImageView fitHeight="154.0" fitWidth="672.0" preserveRatio="false" style="-fx-background-radius: 0 0 12 12;">
        <image>
            <Image url="@../../../images/image4.jpg" />
        </image>
    </ImageView>

</VBox>
